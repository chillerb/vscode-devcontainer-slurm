{
  "name": "remote-slurm-containers",
  "displayName": "Slurm Dev Containers",
  "description": "Develop inside Apptainer containers running as Slurm jobs on HPC clusters, similar to Dev Containers.",
  "version": "0.1.1",
  "publisher": "chillerb",
  "license": "MIT",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/chillerb/vscode-devcontainer-slurm.git"
  },
  "bugs": {
    "url": "https://github.com/chillerb/vscode-devcontainer-slurm/issues"
  },
  "homepage": "https://github.com/chillerb/vscode-devcontainer-slurm#readme",
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "slurm",
    "apptainer",
    "singularity",
    "hpc",
    "devcontainer",
    "remote"
  ],
  "extensionKind": [
    "ui"
  ],
  "extensionDependencies": [
    "ms-vscode-remote.remote-ssh"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jsonc",
        "filenamePatterns": [
          "**/.slurm-devcontainer/slurm-devcontainer.json"
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/.slurm-devcontainer/slurm-devcontainer.json",
        "url": "./schemas/slurm-devcontainer.schema.json"
      }
    ],
    "configuration": {
      "title": "Slurm Dev Containers",
      "properties": {
        "remoteSlurmContainers.sshPath": {
          "type": "string",
          "default": "ssh",
          "description": "Path to the local ssh executable used to run commands on the cluster login node."
        },
        "remoteSlurmContainers.openInNewWindow": {
          "type": "boolean",
          "default": true,
          "description": "Open the container in a new window instead of replacing the current one."
        },
        "remoteSlurmContainers.connectTimeoutMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "How long to wait for the Slurm job to start and the container to become ready."
        }
      }
    },
    "commands": [
      {
        "command": "remoteSlurmContainers.open",
        "title": "Open Folder in Container",
        "category": "Slurm Dev Containers"
      },
      {
        "command": "remoteSlurmContainers.connect",
        "title": "Connect to Container...",
        "category": "Slurm Dev Containers"
      },
      {
        "command": "remoteSlurmContainers.add",
        "title": "Add Container...",
        "category": "Slurm Dev Containers"
      },
      {
        "command": "remoteSlurmContainers.stop",
        "title": "Stop Container Job...",
        "category": "Slurm Dev Containers"
      },
      {
        "command": "remoteSlurmContainers.remove",
        "title": "Remove Container from List...",
        "category": "Slurm Dev Containers"
      },
      {
        "command": "remoteSlurmContainers.showLog",
        "title": "Show Job Log...",
        "category": "Slurm Dev Containers"
      },
      {
        "command": "remoteSlurmContainers.addConfig",
        "title": "Add Configuration File...",
        "category": "Slurm Dev Containers"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "remoteSlurmContainers.open",
          "when": "remoteName == ssh-remote"
        },
        {
          "command": "remoteSlurmContainers.addConfig",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && mocha --ui tdd \"out/test/unit/**/*.test.js\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "mocha": "^11.8.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
